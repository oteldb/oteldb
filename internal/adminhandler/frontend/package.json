{
  "name": "@oteldb/admin-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "oteldb admin panel — full-featured web UI with an Orval-generated typed API client.",
  "scripts": {
    "gen": "orval --config ./orval.config.ts",
    "dev": "vite",
    "build": "orval --config ./orval.config.ts && tsc -b && vite build",
    "build:only": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "fmt": "biome format --write .",
    "lint": "biome check ."
  },
  "dependencies": {
    "@gravity-ui/charts": "^2.0.0",
    "@gravity-ui/icons": "^2.23.1",
    "@gravity-ui/navigation": "^7.1.3",
    "@gravity-ui/uikit": "^7.47.1",
    "@tanstack/react-query": "^5.106.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "orval": "8.46.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
